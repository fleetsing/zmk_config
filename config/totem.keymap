#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define LEFT_HAND_POS 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25
#define RIGHT_HAND_POS 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31
#define THUMB_POS 32 33 34 35 36 37

/ {
    macros {
        meh: meh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT &kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL &kp LSHFT &kp LALT>;
        };

        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT &kp LALT &kp LGUI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL &kp LSHFT &kp LALT &kp LGUI>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <RIGHT_HAND_POS THUMB_POS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <LEFT_HAND_POS THUMB_POS>;
            hold-trigger-on-release;
        };

        lmeh: left_meh_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap;
            bindings = <&meh>, <&kp>;

            hold-trigger-key-positions = <RIGHT_HAND_POS THUMB_POS>;
            hold-trigger-on-release;
        };

        lhyp: left_hyper_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap;
            bindings = <&hyper>, <&kp>;

            hold-trigger-key-positions = <RIGHT_HAND_POS THUMB_POS>;
            hold-trigger-on-release;
        };

        rhyp: right_hyper_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap;
            bindings = <&hyper>, <&kp>;

            hold-trigger-key-positions = <LEFT_HAND_POS THUMB_POS>;
            hold-trigger-on-release;
        };

        rmeh: right_meh_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap;
            bindings = <&meh>, <&kp>;

            hold-trigger-key-positions = <LEFT_HAND_POS THUMB_POS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        macos_layer {
            bindings = <
       &kp X              &kp G        &kp D         &kp F        &kp B        &kp Q       &kp H          &kp U                  &kp O        &kp Z
       &hml LEFT_SHIFT R  &hml LALT S  &hml LCTRL T  &hml LGUI N  &kp K        &kp J       &hmr RGUI L    &hmr RCTRL E           &hmr RALT A  &hmr RIGHT_SHIFT I
&kp W  &kp SQT            &kp C        &lmeh 0 M     &lhyp 0 P    &kp V        &kp PERIOD  &rhyp 0 COMMA  &rmeh 0 LG(SEMICOLON)  &kp SQT      &kp LEFT_BRACKET    &kp Y
                                       &kp DEL       &kp TAB      &kp SPACE    &kp RET     &kp ESC        &kp BSPC
            >;

            label = "MacOS";
        };

        pc_layer {
            bindings = <
        &trans  &trans  &trans           &trans               &trans    &trans  &trans                &trans            &trans  &trans
        &trans  &trans  &hml LEFT_GUI T  &hml LEFT_CONTROL N  &trans    &trans  &hmr RIGHT_CONTROL L  &hmr RIGHT_GUI E  &trans  &trans
&trans  &trans  &trans  &trans           &trans               &trans    &trans  &trans                &trans            &trans  &trans  &trans
                        &trans           &trans               &trans    &trans  &trans                &trans
            >;

            label = "PC";
        };

        nav_layer {
            bindings = <
       &none                &kp LG(K_CUT)      &kp LG(K_COPY)         &kp LG(K_PASTE)    &none              &none     &kp PG_DN  &kp PG_UP  &kp INSERT  &none
       &hml LEFT_SHIFT F16  &hml LEFT_ALT F15  &hml LEFT_CONTROL F14  &hml LEFT_GUI F13  &kp PRINTSCREEN    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT   &none
&none  &none                &none              &lmeh 0 K_REDO         &lhyp 0 K_UNDO     &none              &none     &kp END    &kp HOME   &none       &none  &none
                                               &none                  &none              &none              &none     &none      &none
            >;

            label = "Nav";
        };

        pc_nav_layer {
            bindings = <
        &trans  &trans  &trans             &trans                 &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &hml LEFT_GUI F14  &hml LEFT_CONTROL F13  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans             &trans                 &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans             &trans                 &trans    &trans  &trans  &trans
            >;

            label = "Nav ";
        };

        num_layer {
            bindings = <
       &none           &none         &none             &none         &none    &none     &kp N7  &kp N8  &kp N9  &none
       &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_GUI  &none    &kp BSPC  &kp N4  &kp N5  &kp N6  &kp N0
&none  &none           &none         &none             &none         &none    &none     &kp N1  &kp N2  &kp N3  &none   &none
                                     &none             &none         &none    &none     &kp N0  &none
            >;

            label = "Num";
        };

        pc_num_layer {
            bindings = <
        &trans  &trans  &trans        &trans            &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &kp LEFT_GUI  &kp LEFT_CONTROL  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans        &trans            &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans        &trans            &trans    &trans  &trans  &trans
            >;

            label = "Num ";
        };
    };
};
